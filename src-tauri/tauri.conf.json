{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catalyst",
  "version": "2.6.1",
  "identifier": "com.frccatalyst.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Catalyst",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TomAs-1226/CatalystApp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2MURCMTYzMUY3RUVCM0MKUldRODYzNGZZN0VkdG1hc1FMMDBuSUwwY3MvYmRnZmVLNHJNMTlpOXVTZG1pZ3d0cHArS25YeDcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*",
      "resources/mcp/*",
      "resources/mcp/data/*",
      "resources/console/*"
    ],
    "category": "DeveloperTool",
    "shortDescription": "FrcCatalyst desktop companion",
    "longDescription": "The Catalyst tools in one window, plus one-click install of the FrcCatalyst vendordep into your robot project."
  }
}
