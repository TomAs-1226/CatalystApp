{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Catalyst default capability: window controls, dialog, scoped HTTP, and the updater.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }, { "url": "https://tomas-1226.github.io/*" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://maven.ctr-electronics.com/*" },
        { "url": "https://3015rangerrobotics.github.io/*" },
        { "url": "https://maven.photonvision.org/*" },
        { "url": "https://tomas-1226.github.io/*" }
      ]
    }
  ]
}
